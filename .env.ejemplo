# Copia este archivo como .env y pon tus valores (no lo compartas)

# --- hCaptcha (https://dashboard.hcaptcha.com) ---
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# --- Correo real (ej. Gmail con contraseña de aplicación) ---
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USUARIO=tucorreo@gmail.com
# EMAIL_CLAVE=
# EMAIL_REMITENTE=Facturación Turística IK <tucorreo@gmail.com>

# --- SQL Server (opcional; sin esto usa SQLite) ---
# DB_MOTOR=mssql
# DB_NOMBRE=facturacion_turistica
# DB_USUARIO=
# DB_CLAVE=
# DB_SERVIDOR=localhost\SQLEXPRESS

# --- Producción ---
# DJANGO_DEBUG=false
# DJANGO_SECRET_KEY=
# DJANGO_ALLOWED_HOSTS=

# --- Asistente de IA (Claude) ---
# Crea tu clave en https://console.anthropic.com  (sin clave, el asistente funciona en modo básico)
# IA gratis y sin tarjeta: crea la clave en https://console.groq.com/keys
# GROQ_API_KEY=
# Otra opción gratis (si Google la habilita en tu proyecto): https://aistudio.google.com
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# IA de pago (si hay las dos claves, se usa Claude):
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
